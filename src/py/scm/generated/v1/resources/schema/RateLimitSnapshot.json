{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.RateLimitSnapshot",
    "type": "object",
    "properties": {
        "request_limit": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Total request quota, when reported."
        },
        "requests_remaining": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Requests remaining in the current quota window, when reported."
        },
        "burst_limit": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Burst quota, when reported."
        },
        "burst_remaining": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Burst requests remaining, when reported."
        },
        "reset_seconds": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Seconds until the quota resets, when reported."
        },
        "reset_time": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Provider-formatted quota reset time, when reported."
        },
        "retry_after_seconds": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Provider-requested retry delay in seconds, when reported."
        },
        "observed_at": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.Rfc3339Timestamp",
            "description": "Time at which SCM observed this rate-limit state."
        }
    },
    "required": [
        "request_limit",
        "requests_remaining",
        "burst_limit",
        "burst_remaining",
        "reset_seconds",
        "reset_time",
        "retry_after_seconds",
        "observed_at"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Rate-limit information observed on the provider response."
}
