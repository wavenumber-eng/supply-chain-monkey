            "anyOf": [
                {
                    "$ref": "JsonInteger.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "requests_remaining": {
            "anyOf": [
                {
                    "$ref": "JsonInteger.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "burst_limit": {
            "anyOf": [
                {
                    "$ref": "JsonInteger.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "burst_remaining": {
            "anyOf": [
                {
                    "$ref": "JsonInteger.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "reset_seconds": {
            "anyOf": [
                {
                    "$ref": "JsonInteger.json"
                },
                {
                    "type": "null"
                }
            ]
        },
        "reset_time": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
