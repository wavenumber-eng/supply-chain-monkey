{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.EnvelopeMetadata",
    "type": "object",
    "properties": {
        "status": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.EnvelopeStatus",
            "description": "High-level provider outcome."
        },
        "supplier": {
            "type": "string",
            "description": "Canonical or requested supplier name associated with the outcome."
        },
        "parameter_field_name": {
            "type": "string",
            "description": "Query parameter name used to identify the requested part."
        },
        "provider_latency_ms": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger",
            "description": "Provider execution time measured by SCM in milliseconds."
        },
        "provider_capabilities": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.SupplierCapabilities"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Provider features known at request time."
        },
        "rate_limit": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.RateLimitSnapshot"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Provider rate-limit state observed for this request."
        },
        "service_timestamp": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.Rfc3339Timestamp",
            "description": "Time at which SCM produced the response."
        },
        "cached": {
            "type": "boolean",
            "description": "Whether SCM returned a cached provider result."
        },
        "error": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Sanitized human-readable error, or null for normal outcomes."
        },
        "error_detail": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.ServiceErrorDetail"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Sanitized structured error details, when available."
        }
    },
    "required": [
        "status",
        "supplier",
        "parameter_field_name",
        "provider_latency_ms",
        "provider_capabilities",
        "rate_limit",
        "service_timestamp",
        "cached",
        "error",
        "error_detail"
    ],
    "description": "Metadata shared by typed SCM operation envelopes."
}
