{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.EventStreamResponse",
    "type": "object",
    "properties": {
        "status_code": {
            "type": "number",
            "const": 200,
            "description": "HTTP success status."
        },
        "content_type": {
            "type": "string",
            "const": "text/event-stream",
            "description": "Server-sent-event media type."
        },
        "cache_control": {
            "type": "string",
            "const": "no-cache",
            "description": "Directive preventing response caching."
        },
        "accelerator_buffering": {
            "type": "string",
            "const": "no",
            "description": "Directive disabling reverse-proxy buffering."
        },
        "body": {
            "type": "string",
            "description": "Serialized server-sent-event byte stream."
        }
    },
    "required": [
        "status_code",
        "content_type",
        "cache_control",
        "accelerator_buffering",
        "body"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "HTTP server-sent-event response used by the legacy stream."
}
