# supply_chain_monkey live-provider test configuration
#
# Copy to .env in C:\eli\toolz\supply_chain_monkey when you want to run
# live Digikey / Mouser / Claude-assisted tests.

# Set to 1 to enable live network tests in tests/L0_foundation/test_supplier_interface.py
SUPPLY_CHAIN_ENABLE_LIVE_TESTS=0

# Digikey Product Information API v4
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser Search API
MOUSER_API_KEY=

# JLCPCB Open API
# Used for JLC official detail lookup and direct API probing/research.
# Signature docs require:
#   - appid
#   - accesskey
#   - secretKey (HMAC-SHA256 signing key)
# The tokenization keys are a separate RSA public/private pair used for the
# privacy/encryption path, not for the HMAC request signature.
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
JLCPCB_TOKENIZATION_PUBLIC_KEY_PATH=
JLCPCB_TOKENIZATION_PRIVATE_KEY_PATH=

# Optional Claude helper for scraper fallback research
ANTHROPIC_API_KEY=
