# supply-chain-monkey service configuration
#
# Copy to .env for local development:
#   cp .env.template .env
#
# Then run with:
#   uv run uvicorn supply_chain_monkey.main:app --reload --env-file .env

# Service auth token (required for all API calls except /v1/health)
SCM_SERVICE_TOKEN=

# Set to 1 to enable live network tests
SUPPLY_CHAIN_ENABLE_LIVE_TESTS=0

# Digikey Product Information API v4
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Mouser Search API
MOUSER_API_KEY=

# JLCPCB Open API (optional — scraper works without these)
# Signature docs require appid, accesskey, secretKey (HMAC-SHA256 signing key).
# The tokenization keys are a separate RSA public/private pair used for the
# privacy/encryption path, not for the HMAC request signature.
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
JLCPCB_TOKENIZATION_PUBLIC_KEY_PATH=
JLCPCB_TOKENIZATION_PRIVATE_KEY_PATH=

# Optional Claude helper for scraper fallback
ANTHROPIC_API_KEY=
