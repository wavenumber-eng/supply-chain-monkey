{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.search-envelope",
    "type": "object",
    "properties": {
        "data": {
            "anyOf": [
                {
                    "type": "array",
                    "items": {
                        "$ref": "Part.json"
                    }
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "data"
    ],
    "allOf": [
        {
            "$ref": "EnvelopeMetadata.json"
        }
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}