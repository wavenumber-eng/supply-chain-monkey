{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.ValidationErrorItem",
    "type": "object",
    "properties": {
        "loc": {
            "type": "array",
            "items": {
                "anyOf": [
                    {
                        "type": "string"
                    },
                    {
                        "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonInteger"
                    }
                ]
            },
            "description": "Request location of the invalid value."
        },
        "msg": {
            "type": "string",
            "description": "Human-readable validation message."
        },
        "type": {
            "type": "string",
            "description": "Stable validation error type."
        },
        "input": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.JsonValue",
            "description": "Rejected input value, when included by FastAPI."
        },
        "ctx": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.RecordJsonValue",
            "description": "Additional validation context, when included by FastAPI."
        }
    },
    "required": [
        "loc",
        "msg",
        "type"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "One FastAPI-compatible validation failure."
}
