{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.AccountUpstreamErrorResponse",
    "type": "object",
    "properties": {
        "status_code": {
            "type": "number",
            "const": 502,
            "description": "HTTP bad-gateway status."
        },
        "body": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.HttpErrorDetail",
            "description": "Sanitized upstream or incomplete scan error."
