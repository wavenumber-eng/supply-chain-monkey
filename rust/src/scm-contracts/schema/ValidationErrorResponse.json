{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.ValidationErrorResponse",
    "type": "object",
    "properties": {
        "status_code": {
            "type": "number",
            "const": 422,
            "description": "HTTP unprocessable-content status."
        },
        "body": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.ValidationErrorDetail",
            "description": "Structured request validation failures."
        }
    },
    "required": [
        "status_code",
        "body"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Response returned when request validation fails."
}
