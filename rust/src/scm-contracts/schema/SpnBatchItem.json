{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.SpnBatchItem",
    "type": "object",
    "properties": {
        "spn": {
            "type": "string"
        },
        "status": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.BatchItemStatus"
        },
        "part": {
            "anyOf": [
                {
                    "$ref": "urn:supply-chain-monkey:schema:v1.declaration.Part"
                },
                {
                    "type": "null"
                }
            ]
        },
        "error": {
            "anyOf": [
                {
                    "type": "string"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "spn",
        "status",
        "part",
        "error"
    ],
    "unevaluatedProperties": {
        "not": {}
    }
}
