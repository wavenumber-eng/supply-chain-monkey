{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:supply-chain-monkey:schema:v1.declaration.BadRequestResponse",
    "type": "object",
    "properties": {
        "status_code": {
            "type": "number",
            "const": 400,
            "description": "HTTP bad-request status."
        },
        "body": {
            "$ref": "urn:supply-chain-monkey:schema:v1.declaration.HttpErrorDetail",
            "description": "Sanitized request failure."
        }
    },
    "required": [
        "status_code",
        "body"
    ],
    "unevaluatedProperties": {
        "not": {}
    },
    "description": "Response returned for a malformed legacy stream request."
}
